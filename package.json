{
  "name": "boleiro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.2",
  "scripts": {
    "dev": "pnpm --filter @boleiro/desktop dev",
    "build": "pnpm --filter @boleiro/desktop build",
    "preview": "pnpm --filter @boleiro/desktop preview",
    "tauri": "pnpm --filter @boleiro/desktop tauri",
    "e2e": "pnpm --filter @boleiro/desktop e2e",
    "test": "vitest run",
    "test:long": "LONG_RUN=1 vitest run packages/engine/src/cli",
    "finances:report": "tsx packages/engine/src/cli/financeReport.ts",
    "strength:report": "tsx packages/engine/src/cli/strengthReport.ts",
    "transfers:report": "tsx packages/engine/src/cli/transferReport.ts",
    "typecheck": "tsc --noEmit -p packages/data && tsc --noEmit -p packages/engine && tsc --noEmit -p packages/game-client && tsc --noEmit -p apps/desktop",
    "lint": "eslint .",
    "career": "tsx packages/engine/src/cli/career.ts",
    "history": "tsx packages/engine/src/cli/history.ts",
    "season": "tsx packages/engine/src/cli/season.ts",
    "calibrate": "tsx packages/engine/src/engine/calibrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
