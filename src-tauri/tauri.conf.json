{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boleiro",
  "version": "0.1.0",
  "identifier": "com.lucasnsaraujo.boleiro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Boleiro",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0a1a10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
